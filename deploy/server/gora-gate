#!/bin/bash
# Forced command for the GitHub Actions deploy key (set in ~gora/.ssh/authorized_keys).
# The key may ONLY: rsync files into /var/www/goraedu (via rrsync) or activate a release.
# No shell, no port forwarding (authorized_keys also sets "restrict").
set -euo pipefail
ROOT=/var/www/goraedu
cmd="${SSH_ORIGINAL_COMMAND:-}"
case "$cmd" in
  "rsync --server"*)
    exec /usr/bin/rrsync "$ROOT"
    ;;
  "activate production "*)
    read -r _ env id <<<"$cmd"
    [[ "$id" =~ ^[0-9a-f]{40}-[0-9]+$ ]] || { echo "bad release id" >&2; exit 2; }
    exec /home/gora/bin/gora-activate "$env" "$id"
    ;;
  *)
    echo "command not allowed" >&2
    exit 1
    ;;
esac
