// Cloudflare Workers (static assets). Workers Builds runs `npm run build`, then `npx wrangler deploy`
// on every push to main. The Worker name in the Cloudflare dashboard must stay "goraedu".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goraedu",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
  },
}
